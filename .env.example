# ---------------------------------------------------------------------------
# Datenbank — Neon
# Die "-pooler"-Variante nehmen, nicht die direkte Verbindung: auf Vercel
# startet jede Anfrage eine eigene Instanz, der Pooler bündelt das.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Stripe
# STRIPE_WEBHOOK_SECRET stammt aus dem Endpoint, den du auf
# https://dashboard.stripe.com/webhooks anlegst (Ereignis:
# checkout.session.completed, Ziel: https://DEINE-DOMAIN/api/stripe/webhook).
# Lokal liefert `stripe listen` ein eigenes Secret — die beiden sind
# unterschiedlich.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_…"
STRIPE_WEBHOOK_SECRET="whsec_…"

# ---------------------------------------------------------------------------
# Logo-Uploads — Vercel Blob
# Legt Vercel beim Anlegen des Blob-Stores selbst in die Projektumgebung.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_…"

# ---------------------------------------------------------------------------
# Admin
# AUTH_SECRET signiert das Sitzungs-Cookie: mindestens 16 Zeichen,
# am besten `openssl rand -hex 32`.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD="etwas-langes-und-eigenes"
AUTH_SECRET="hier-32-zufaellige-hex-zeichen-einsetzen"

# ---------------------------------------------------------------------------
# Öffentliche Adresse — landet in den Stripe-Rücksprungadressen.
# Auf Vercel optional, dort wird VERCEL_PROJECT_PRODUCTION_URL verwendet.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://deine-domain.de"

# ---------------------------------------------------------------------------
# Schützt /api/cron/close. Vercel schickt den Wert als Bearer-Token mit.
# PFLICHT: fehlt er, lehnt der Endpunkt jeden Aufruf ab und die Auktion
# schliesst sich nicht von selbst.
# ---------------------------------------------------------------------------
CRON_SECRET="noch-etwas-zufaelliges"

# ---------------------------------------------------------------------------
# Optional. Zusaetzliche Hosts, von denen Sponsorlogos geladen werden duerfen,
# durch Komma getrennt. Vercel Blob ist bereits erlaubt; eigene Pfade wie
# /logos/x.png ebenfalls. Alles andere weist der Server ab.
# ---------------------------------------------------------------------------
# LOGO_HOST_ALLOWLIST="cdn.deine-domain.de"
